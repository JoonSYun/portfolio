{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.ReverseProxy.Service.HealthChecks": "None",
      "Microsoft.ReverseProxy": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "orchestration-service": {
        "ClusterId": "orchestration-cluster",
        "Match": {
          "Path": "/api/orchestration/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/orchestration"
          }
        ]
        // ✅ RequestHeader Transform 제거 - YARP는 기본적으로 모든 헤더를 전달함
      },
      "orchestration-signalr": {
        "ClusterId": "orchestration-cluster",
        "Match": {
          "Path": "/api/orchestration/orchestrationhub/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/orchestration"
          }
        ]
      },
      "wms-service": {
        "ClusterId": "wms-service-cluster",
        "Match": {
          "Path": "/api/wms/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/wms"
          }
        ]
      }
    },
    "Clusters": {
      "orchestration-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7001/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "wms-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:15390/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[API-Gateway] [{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/apigateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[API-Gateway] [{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },

  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "API Gateway Self",
        "Uri": "http://localhost:6999/health"
      },
      {
        "Name": "Orchestration Service",
        "Uri": "http://localhost:7001/health"
      }
    ],
    "EvaluationTimeInSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60,
    "MaximumHistoryEntriesPerEndpoint": 100,
    "UIPath": "/health-ui",
    "ApiPath": "/health-ui-api",
    "UseRelativeApiPath": false,
    "UseRelativeResourcesPath": false,
    "UseRelativeWebhookPath": false
  },
  "RateLimiting": {
    "ApiLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
