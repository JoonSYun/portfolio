<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reference build targets net8.0 but runs on whatever runtime is installed. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowForge.Abstractions\FlowForge.Abstractions.csproj" />
    <ProjectReference Include="..\FlowForge.Core\FlowForge.Core.csproj" />
    <ProjectReference Include="..\FlowForge.Scheduler\FlowForge.Scheduler.csproj" />
    <ProjectReference Include="..\FlowForge.Sample\FlowForge.Sample.csproj" />
  </ItemGroup>

</Project>
